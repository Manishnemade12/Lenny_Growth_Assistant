# ╔══════════════════════════════════════════════════════════════╗
# ║            The Lenny Growth Assistant                       ║
# ║            Environment Configuration                        ║
# ╚══════════════════════════════════════════════════════════════╝
#
# Copy this file to .env and fill in the required values.
# cp .env.example .env

# ─── Database [REQUIRED] ────────────────────────────────────────
# Local Docker PostgreSQL:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_assistant

# Supabase Direct Connection:
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Transaction Pooler (PgBouncer):
# DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ─── Supabase Configuration [OPTIONAL] ──────────────────────────
# PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...

# ─── Security [REQUIRED in production] ──────────────────────────
SECRET_KEY=change-me-in-production

# ─── Active LLM Provider [REQUIRED] ────────────────────────────
# Options: ollama | anthropic | openai
# Default: ollama (for local demo)
ACTIVE_LLM_PROVIDER=ollama

# ─── Anthropic Cloud Provider [OPTIONAL] ───────────────────────
# ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ─── OpenAI Cloud Provider [OPTIONAL] ─────────────────────────
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ─── Ollama Local Provider [OPTIONAL] ─────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── RAG Configuration [OPTIONAL] ─────────────────────────────
VECTOR_DIMENSION=768
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=20
TOP_K_RERANK=5
SIMILARITY_THRESHOLD=0.3

# ─── Application [OPTIONAL] ───────────────────────────────────
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
MAX_MESSAGE_LENGTH=10000
MAX_TOKENS=4096
STREAM_CHUNK_DELAY_MS=0
